// App distributed to customers.
#include "Shared.xcconfig"

// Production domain (portal, admin and API share one origin, IMPLEMENTATION_PLAN D1).
API_BASE_URL = https:/$()/ruappstore.com/api/v1
API_MODE = live

// Mock fixtures are the only loose JSON resources; keep them out of non-debug builds.
EXCLUDED_SOURCE_FILE_NAMES = *.json
