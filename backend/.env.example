APP_NAME="[BRAND]"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storefront
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passwords use Argon2id (FULL_PLAN §13)
HASH_DRIVER=argon2id

# Storefront domain settings (config/storefront.php)
# Dedicated key for the UDID blind index (IMPLEMENTATION_PLAN G5). Generate with: php -r "echo base64_encode(random_bytes(32));"
STOREFRONT_UDID_HMAC_KEY=
# MySQL triggers that make audit_logs append-only and artifact files immutable (IMPLEMENTATION_PLAN §5.3)
STOREFRONT_DB_IMMUTABILITY_TRIGGERS=true
# Password for the seeded admin account; a random one is printed when empty
SEED_ADMIN_PASSWORD=

# Apple (config/storefront.php → apple). disabled until the Apple Developer account is connected;
# fake simulates App Store Connect locally.
STOREFRONT_APPLE_DRIVER=disabled
STOREFRONT_APPLE_FAKE_PROCESSING_SECONDS=20
# Comma-separated proxy IPs, or * behind a tunnel/load balancer (needed for correct profile callback URLs)
TRUSTED_PROXIES=
