APP_NAME="Ru App Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storefront
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Rate limiting on files: the database store deadlocked under concurrent requests
CACHE_LIMITER=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email codes and password resets. Production uses Brevo SMTP:
#   MAIL_MAILER=smtp MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_SCHEME=null
#   MAIL_USERNAME=<Brevo SMTP login> MAIL_PASSWORD=<Brevo SMTP key>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# IPA storage. local = storage/app/artifacts; s3 = the bucket below (Contabo Object Storage in production:
# AWS_ENDPOINT=https://eu2.contabostorage.com, AWS_DEFAULT_REGION=default, path-style URLs).
ARTIFACTS_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passwords use Argon2id (FULL_PLAN §13)
HASH_DRIVER=argon2id

# Storefront domain settings (config/storefront.php)
# Dedicated key for the UDID blind index (IMPLEMENTATION_PLAN G5). Generate with: php -r "echo base64_encode(random_bytes(32));"
STOREFRONT_UDID_HMAC_KEY=
# MySQL triggers that make audit_logs append-only and artifact files immutable (IMPLEMENTATION_PLAN §5.3)
STOREFRONT_DB_IMMUTABILITY_TRIGGERS=true
# Password for the seeded admin account; a random one is printed when empty
SEED_ADMIN_PASSWORD=

# Apple (config/storefront.php → apple). disabled until the Apple Developer account is connected;
# fake simulates App Store Connect locally.
STOREFRONT_APPLE_DRIVER=disabled
STOREFRONT_APPLE_FAKE_PROCESSING_SECONDS=20
# Telegram subscription bot. Keep the token in the server environment, never in source control.
TELEGRAM_STORE_BOT_TOKEN=
# Optional; otherwise looked up with getMe (used for referral links).
TELEGRAM_STORE_BOT_USERNAME=
# Comma-separated Telegram numeric user IDs: admin panel (/admin), payment confirmation, broadcasts.
TELEGRAM_STORE_ADMIN_IDS=
# Mock mode: admins and testers simulate payments; orders complete for real (activation code, referral bonus).
TELEGRAM_STORE_MOCK_PAYMENTS=true
TELEGRAM_STORE_TESTER_IDS=
# Manual mode: every configured link is a payment method; an admin confirms each payment.
TELEGRAM_STORE_CARD_URL=
TELEGRAM_STORE_SBP_URL=
TELEGRAM_STORE_PAYPAL_URL=
TELEGRAM_STORE_ORDER_TTL_MINUTES=30
TELEGRAM_STORE_SUPPORT_URL=
TELEGRAM_STORE_NEWS_URL=
TELEGRAM_STORE_ACTIVATION_URL=
TELEGRAM_STORE_WELCOME_BANNER=
# Comma-separated proxy IPs, or * behind a tunnel/load balancer (needed for correct profile callback URLs)
TRUSTED_PROXIES=
