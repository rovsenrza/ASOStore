<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the dedicated "storefront" macOS user (P6-RUN-02).
  Install: copy to ~/Library/LaunchAgents/, fill in the values, then
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/az.storefront.runner.plist
  The label is a placeholder until the bundle ID prefix is fixed (P0-04).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>az.storefront.runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/storefront-runner</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>STOREFRONT_RUNNER_BASE_URL</key>
        <string>https://example.com</string>
        <key>STOREFRONT_RUNNER_KEY_ID</key>
        <string>rk_REPLACE_ME</string>
        <key>STOREFRONT_RUNNER_SECRET</key>
        <string>REPLACE_ME</string>
        <key>STOREFRONT_RUNNER_KEYCHAIN</key>
        <string>/Users/storefront/Library/Keychains/signing.keychain-db</string>
        <key>STOREFRONT_RUNNER_WORK_DIR</key>
        <string>/Users/storefront/Library/Caches/storefront-runner</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>/Users/storefront/Library/Logs/storefront-runner.log</string>
</dict>
</plist>
